<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Allow loading assemblies from local paths without zone-of-origin check -->
    <loadFromRemoteSources enabled="true"/>
    <!-- Target .NET Framework 4.x -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </runtime>
</configuration>
